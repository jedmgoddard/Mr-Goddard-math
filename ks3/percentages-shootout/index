<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Mr. Goddard's Penalty Shootout – Percentages</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@400;600;700;900&display=swap');

:root {
  --gold:   #f5c518;
  --white:  #ffffff;
  --navy:   #0e1b3d;
  --dknavy: #070f22;
  --red:    #e63946;
  --green:  #2dc653;
  --grey:   #8899aa;
  --ltgrey: #c8d4e4;
  --panel:  rgba(7,15,34,0.94);
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; }

body {
  font-family: 'Inter', sans-serif;
  background: var(--dknavy);
  color: var(--white);
  min-height: 100vh;
}

body::before {
  content: '';
  position: fixed; inset: 0; z-index: 0;
  background:
    repeating-linear-gradient(0deg, transparent 0px, transparent 55px, rgba(0,0,0,0.07) 55px, rgba(0,0,0,0.07) 110px),
    linear-gradient(175deg, #0f5c1e 0%, #1a7a2e 40%, #145f23 100%);
}

/* ── Header ── */
.header {
  position: relative; z-index: 10;
  background: var(--dknavy);
  border-bottom: 4px solid var(--gold);
  padding: 14px 24px;
  display: flex; align-items: center; gap: 14px;
  box-shadow: 0 4px 20px rgba(0,0,0,0.6);
}
.header-icon { font-size: 1.9rem; }
.header-titles h1 {
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.55rem; letter-spacing: 2.5px;
  color: var(--gold); line-height: 1;
}
.header-titles p { color: var(--grey); font-size: 0.78rem; margin-top: 2px; }
.score-pill {
  margin-left: auto;
  background: var(--gold); color: var(--navy);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1.05rem; letter-spacing: 1px;
  padding: 6px 16px; border-radius: 30px; white-space: nowrap;
}

/* ── Name banner ── */
.name-banner {
  position: relative; z-index: 10;
  background: rgba(7,15,34,0.96);
  border-bottom: 2px solid rgba(245,197,24,0.25);
  padding: 10px 24px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
}
.name-banner label { font-weight: 700; font-size: 0.85rem; color: var(--gold); }
.name-input {
  border: 2px solid rgba(245,197,24,0.35); border-radius: 8px;
  padding: 6px 12px; font-size: 0.88rem; font-family: inherit;
  background: rgba(255,255,255,0.06); color: var(--white);
  outline: none; width: 185px; transition: border-color 0.2s;
}
.name-input::placeholder { color: var(--grey); }
.name-input:focus { border-color: var(--gold); }
.name-note { font-size: 0.73rem; color: var(--grey); font-style: italic; }

/* ── Progress dots ── */
.progress-strip {
  position: relative; z-index: 10;
  background: rgba(7,15,34,0.88);
  padding: 10px 24px;
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.prog-label { font-size: 0.73rem; color: var(--grey); white-space: nowrap; font-weight: 600; letter-spacing: 0.5px; }
.balls-row { display: flex; gap: 7px; flex-wrap: wrap; }
.ball-dot {
  width: 20px; height: 20px; border-radius: 50%;
  border: 2px solid rgba(255,255,255,0.15);
  background: rgba(255,255,255,0.07);
  transition: all 0.35s cubic-bezier(.34,1.56,.64,1);
  font-size: 0.6rem; display: flex; align-items: center; justify-content: center;
}
.ball-dot.scored  { background: var(--green); border-color: var(--green); box-shadow: 0 0 8px var(--green); }
.ball-dot.missed  { background: var(--red);   border-color: var(--red);   box-shadow: 0 0 8px var(--red); }
.ball-dot.current { background: var(--gold);  border-color: var(--gold);  animation: bpulse 0.9s ease-in-out infinite; }
@keyframes bpulse { 0%,100%{transform:scale(1);box-shadow:0 0 6px var(--gold)} 50%{transform:scale(1.25);box-shadow:0 0 14px var(--gold)} }

/* ── Game area ── */
.game-area {
  position: relative; z-index: 10;
  max-width: 720px; margin: 28px auto 0; padding: 0 16px;
}

/* ── Goal container ── */
.goal-wrap {
  display: flex; justify-content: center;
  margin-bottom: 20px;
  position: relative;
  user-select: none;
}

/* The SVG goal is the sizing anchor */
.goal-svg { width: min(420px, 100%); display: block; }

/* ── Overlay zones — absolutely positioned over the SVG ── */
/* These sit inside .goal-wrap, which is position:relative */
.zones-overlay {
  position: absolute;
  /* Match the SVG viewBox ratio 420/210 = 2:1 */
  /* We'll size and position via JS after render */
  top: 0; left: 50%; transform: translateX(-50%);
  display: none; /* hidden until correct answer */
  pointer-events: none;
}
.zones-overlay.visible {
  display: block;
  pointer-events: all;
}

/* Each zone is a clickable rectangle */
.goal-zone {
  position: absolute;
  cursor: pointer;
  border: 2px solid transparent;
  border-radius: 4px;
  background: rgba(245,197,24,0.0);
  transition: background 0.15s, border-color 0.15s;
  display: flex; align-items: center; justify-content: center;
}
.goal-zone:hover {
  background: rgba(245,197,24,0.18);
  border-color: rgba(245,197,24,0.6);
}
.goal-zone .zone-arrow {
  font-size: 1.4rem;
  opacity: 0;
  transition: opacity 0.15s;
  pointer-events: none;
}
.goal-zone:hover .zone-arrow { opacity: 1; }

/* Shoot-here prompt */
.shoot-prompt {
  position: absolute;
  bottom: -8px; left: 50%; transform: translateX(-50%);
  font-family: 'Bebas Neue', sans-serif;
  font-size: 1rem; letter-spacing: 2px;
  color: var(--gold);
  animation: promptpulse 0.8s ease-in-out infinite;
  white-space: nowrap;
  pointer-events: none;
  display: none;
}
.shoot-prompt.visible { display: block; }
@keyframes promptpulse { 0%,100%{opacity:1} 50%{opacity:0.4} }

/* ── Ball ── */
.ball-svg {
  position: absolute;
  width: 48px; height: 48px;
  left: 50%; bottom: -8px;
  transform: translateX(-50%);
  filter: drop-shadow(0 4px 10px rgba(0,0,0,0.6));
  transition: none;
  z-index: 20;
  pointer-events: none;
}
.ball-svg.shooting {
  transition: left 0.5s cubic-bezier(.15,.8,.3,1),
              bottom 0.5s cubic-bezier(.15,.8,.3,1),
              transform 0.5s ease,
              opacity 0.5s ease;
}

/* ── Result flash ── */
.result-flash {
  position: absolute; top: 8px; left: 50%; transform: translateX(-50%);
  font-family: 'Bebas Neue', sans-serif; font-size: 2.5rem; letter-spacing: 3px;
  opacity: 0; pointer-events: none; white-space: nowrap;
  text-shadow: 0 2px 16px rgba(0,0,0,0.7);
  transition: opacity 0.25s;
  z-index: 30;
}
.result-flash.show { opacity: 1; }
.result-flash.goal { color: var(--green); }
.result-flash.miss { color: var(--red); }

/* ── Question card ── */
.q-card {
  background: var(--panel);
  border: 2px solid rgba(245,197,24,0.25);
  border-radius: 14px;
  padding: 22px 24px;
  backdrop-filter: blur(8px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5);
  margin-bottom: 18px;
}
.q-header { display: flex; align-items: center; gap: 10px; margin-bottom: 14px; }
.q-num {
  font-family: 'Bebas Neue', sans-serif;
  background: var(--gold); color: var(--navy);
  padding: 3px 11px; border-radius: 20px;
  font-size: 1rem; letter-spacing: 1px; white-space: nowrap;
}
.q-topic { font-size: 0.72rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: var(--grey); }
.q-text { font-size: 1.05rem; font-weight: 700; color: var(--white); line-height: 1.45; margin-bottom: 18px; }

/* ── MCQ options ── */
.options-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.opt-btn {
  padding: 12px 14px;
  background: rgba(255,255,255,0.06);
  border: 2px solid rgba(255,255,255,0.12);
  border-radius: 10px;
  color: var(--white); font-family: inherit;
  font-size: 0.95rem; font-weight: 600;
  cursor: pointer; text-align: left;
  transition: all 0.18s;
}
.opt-btn:hover:not(:disabled) { background: rgba(245,197,24,0.12); border-color: var(--gold); transform: translateY(-1px); }
.opt-btn:disabled { cursor: default; }
.opt-btn.correct { background: rgba(45,198,83,0.18); border-color: var(--green); color: var(--green); }
.opt-btn.wrong   { background: rgba(230,57,70,0.18);  border-color: var(--red);   color: var(--red); }

/* ── Typed answer ── */
.typed-row { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
.typed-input {
  flex: 1; min-width: 130px; max-width: 220px;
  border: 2px solid rgba(255,255,255,0.15); border-radius: 9px;
  padding: 10px 14px; font-size: 1rem; font-family: inherit;
  background: rgba(255,255,255,0.07); color: var(--white);
  outline: none; transition: border-color 0.2s;
}
.typed-input::placeholder { color: var(--grey); }
.typed-input:focus { border-color: var(--gold); }
.typed-input.correct { border-color: var(--green); background: rgba(45,198,83,0.1); color: var(--green); }
.typed-input.wrong   { border-color: var(--red);   background: rgba(230,57,70,0.1);  color: var(--red); }
.shoot-btn {
  padding: 10px 22px;
  background: var(--gold); color: var(--navy);
  border: none; border-radius: 9px;
  font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 1.5px;
  cursor: pointer; transition: transform 0.12s, background 0.15s; white-space: nowrap;
}
.shoot-btn:hover { background: #d4a800; transform: scale(1.04); }
.shoot-btn:active { transform: scale(0.96); }
.shoot-btn:disabled { background: var(--grey); cursor: default; transform: none; }

/* ── Feedback ── */
.q-feedback {
  margin-top: 11px; font-size: 0.88rem; font-weight: 700;
  display: none; padding: 7px 12px; border-radius: 7px;
}
.q-feedback.correct { display: block; background: rgba(45,198,83,0.15); color: var(--green); }
.q-feedback.wrong   { display: block; background: rgba(230,57,70,0.15);  color: var(--red); }

/* ── Nav ── */
.nav-row { display: flex; justify-content: center; gap: 12px; margin-bottom: 30px; }
.nav-btn {
  padding: 12px 30px;
  background: rgba(255,255,255,0.08);
  border: 2px solid rgba(255,255,255,0.15);
  border-radius: 10px; color: var(--white);
  font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 1.5px;
  cursor: pointer; transition: all 0.18s;
}
.nav-btn:hover { background: rgba(245,197,24,0.12); border-color: var(--gold); }
.nav-btn.primary { background: var(--gold); color: var(--navy); border-color: var(--gold); }
.nav-btn.primary:hover { background: #d4a800; }

/* ── Final screen ── */
#finalScreen {
  display: none;
  position: relative; z-index: 10;
  max-width: 720px; margin: 28px auto 40px; padding: 0 16px;
}
.final-card {
  background: var(--panel);
  border: 2px solid rgba(245,197,24,0.3);
  border-radius: 14px; padding: 30px 26px;
  backdrop-filter: blur(10px);
  box-shadow: 0 10px 40px rgba(0,0,0,0.6);
  text-align: center;
}
.final-card h2 { font-family: 'Bebas Neue', sans-serif; font-size: 2.4rem; letter-spacing: 3px; color: var(--gold); margin-bottom: 6px; }
.final-score { font-family: 'Bebas Neue', sans-serif; font-size: 4rem; letter-spacing: 2px; color: var(--white); line-height: 1; }
.final-score span { color: var(--gold); }
.final-stars { font-size: 2rem; margin: 8px 0 4px; }
.final-msg { color: var(--grey); font-size: 1rem; margin-bottom: 22px; }

.breakdown { width: 100%; border-collapse: collapse; margin-bottom: 22px; text-align: left; font-size: 0.82rem; }
.breakdown th { background: rgba(245,197,24,0.12); color: var(--gold); padding: 8px 10px; font-weight: 700; letter-spacing: 0.5px; border-bottom: 1px solid rgba(245,197,24,0.2); }
.breakdown td { padding: 7px 10px; border-bottom: 1px solid rgba(255,255,255,0.06); color: var(--ltgrey); }
.breakdown tr:last-child td { border-bottom: none; }
.breakdown .icon-cell { width: 28px; text-align: center; }

/* Submission */
.gen-section { border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; margin-top: 6px; }
.gen-section h3 { font-family: 'Bebas Neue', sans-serif; font-size: 1.2rem; letter-spacing: 1.5px; color: var(--gold); margin-bottom: 12px; }
.gen-btn { padding: 11px 26px; background: rgba(45,198,83,0.15); border: 2px solid var(--green); border-radius: 10px; color: var(--green); font-family: 'Bebas Neue', sans-serif; font-size: 1.1rem; letter-spacing: 1.5px; cursor: pointer; transition: all 0.18s; }
.gen-btn:hover { background: rgba(45,198,83,0.28); }
.summary-text-wrap { margin-top: 14px; display: none; text-align: left; }
.summary-textarea { width: 100%; min-height: 280px; background: rgba(0,0,0,0.5); color: #7fffbc; border: 2px solid rgba(45,198,83,0.4); border-radius: 10px; padding: 13px; font-family: 'Courier New', monospace; font-size: 0.78rem; line-height: 1.65; resize: vertical; outline: none; }
.copy-row { display: flex; align-items: center; gap: 12px; margin-top: 10px; flex-wrap: wrap; }
.copy-btn { padding: 9px 22px; background: var(--gold); color: var(--navy); border: none; border-radius: 8px; font-family: 'Bebas Neue', sans-serif; font-size: 1rem; letter-spacing: 1px; cursor: pointer; transition: transform 0.12s; }
.copy-btn:hover { background: #d4a800; transform: scale(1.03); }
.copy-confirm { color: var(--green); font-weight: 700; font-size: 0.85rem; display: none; }
.classroom-steps { margin-top: 12px; background: rgba(0,0,0,0.3); border-radius: 8px; padding: 11px 14px; color: var(--grey); font-size: 0.78rem; line-height: 1.75; text-align: left; }
.classroom-steps strong { color: var(--gold); }

.footer { position: relative; z-index: 10; text-align: center; padding: 18px; color: rgba(136,153,170,0.5); font-size: 0.75rem; }

@media (max-width: 480px) {
  .options-grid { grid-template-columns: 1fr; }
  .header-titles h1 { font-size: 1.2rem; }
  .final-score { font-size: 3rem; }
}
</style>
</head>
<body>

<div class="header">
  <div class="header-icon">⚽</div>
  <div class="header-titles">
    <h1>MR. GODDARD'S PENALTY SHOOTOUT</h1>
    <p>Percentages Edition — Answer correctly, then pick your spot!</p>
  </div>
  <div class="score-pill" id="scoreDisplay">0 GOALS</div>
</div>

<div class="name-banner">
  <label for="playerName">⚽ Player Name:</label>
  <input class="name-input" id="playerName" type="text" placeholder="Type your full name" autocomplete="name">
  <span class="name-note">Appears on your submission for Mr. Goddard</span>
</div>

<div class="progress-strip">
  <span class="prog-label">PENALTIES:</span>
  <div class="balls-row" id="ballsRow"></div>
</div>

<div class="game-area" id="gameArea">

  <!-- Goal + ball + zones -->
  <div class="goal-wrap" id="goalWrap">

    <!-- Static goal SVG -->
    <svg class="goal-svg" id="goalSvg" viewBox="0 0 420 210" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="net" width="21" height="21" patternUnits="userSpaceOnUse">
          <path d="M21 0L0 0 0 21" fill="none" stroke="rgba(255,255,255,0.13)" stroke-width="0.8"/>
        </pattern>
      </defs>
      <!-- Net fill -->
      <rect x="18" y="8" width="384" height="180" fill="url(#net)"/>
      <!-- Posts & crossbar -->
      <polyline points="18,195 18,8 402,8 402,195" fill="none" stroke="#dde4ee" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"/>
      <!-- Ground line -->
      <line x1="18" y1="195" x2="402" y2="195" stroke="#dde4ee" stroke-width="6"/>
    </svg>

    <!-- Clickable zones overlay (sized/positioned by JS) -->
    <div class="zones-overlay" id="zonesOverlay">
      <!-- 6 zones: top-left, top-centre, top-right, bottom-left, bottom-centre, bottom-right -->
      <!-- Populated by JS -->
    </div>

    <!-- Shoot-here prompt -->
    <div class="shoot-prompt" id="shootPrompt">⚽ PICK YOUR SPOT!</div>

    <!-- Ball -->
    <svg class="ball-svg" id="ballSvg" viewBox="0 0 52 52" xmlns="http://www.w3.org/2000/svg">
      <circle cx="26" cy="26" r="25" fill="white" stroke="#ccc" stroke-width="1"/>
      <polygon points="26,4 31,16 21,16" fill="#222"/>
      <polygon points="44,18 37,27 45,34" fill="#222"/>
      <polygon points="37,46 26,39 30,28" fill="#222"/>
      <polygon points="15,46 22,35 10,34" fill="#222"/>
      <polygon points="8,18 19,27 11,34" fill="#222"/>
      <circle cx="26" cy="26" r="7" fill="#222"/>
    </svg>

    <!-- Result flash -->
    <div class="result-flash" id="resultFlash"></div>
  </div>

  <!-- Question card -->
  <div class="q-card" id="qCard">
    <div class="q-header">
      <span class="q-num" id="qNum">Q1 / 10</span>
      <span class="q-topic" id="qTopic"></span>
    </div>
    <div class="q-text" id="qText"></div>
    <div id="qAnswerArea"></div>
    <div class="q-feedback" id="qFeedback"></div>
  </div>

  <div class="nav-row" id="navRow" style="display:none;">
    <button class="nav-btn primary" id="nextBtn" onclick="nextQuestion()">NEXT PENALTY →</button>
  </div>

</div>

<!-- Final screen -->
<div id="finalScreen">
  <div class="final-card">
    <h2>⚽ FULL TIME!</h2>
    <div class="final-score" id="finalScore">0 <span>/ 10</span></div>
    <div class="final-stars" id="finalStars"></div>
    <div class="final-msg" id="finalMsg"></div>

    <table class="breakdown" id="breakdownTable">
      <thead><tr>
        <th class="icon-cell"></th>
        <th>Question</th>
        <th>Your Answer</th>
        <th>Correct Answer</th>
      </tr></thead>
      <tbody id="breakdownBody"></tbody>
    </table>

    <div class="gen-section">
      <h3>📤 Submit to Mr. Goddard's Google Classroom</h3>
      <button class="gen-btn" onclick="generateSummary()">📋 GENERATE MY SUBMISSION</button>
      <div class="summary-text-wrap" id="summaryWrap">
        <textarea class="summary-textarea" id="summaryText" readonly></textarea>
        <div class="copy-row">
          <button class="copy-btn" onclick="copySummary()">📋 Copy to Clipboard</button>
          <span class="copy-confirm" id="copyConfirm">✅ Copied!</span>
        </div>
        <div class="classroom-steps">
          <strong>How to submit to Google Classroom:</strong><br>
          1. Click <strong>Copy to Clipboard</strong> above<br>
          2. Open Google Classroom → find the Percentages Shootout assignment<br>
          3. Click <strong>Add private comment</strong> or the response box<br>
          4. Paste with <strong>Ctrl+V</strong> (or Cmd+V on Mac / long-press on iPad)<br>
          5. Click <strong>Submit</strong> — done! ✅
        </div>
      </div>
    </div>
  </div>
</div>

<div class="footer">Mr. Goddard's Penalty Shootout · Percentages · ⚽</div>

<script>
// ─────────────────────────────────────────────────────────────────────────────
// QUESTIONS
// ─────────────────────────────────────────────────────────────────────────────
const QUESTIONS = [
  {
    topic: "Percentage of an Amount",
    text: "Find 35% of £240.",
    type: "mcq",
    options: ["£72", "£84", "£96", "£68"],
    answer: "£84",
    solution: "10% = £24, so 35% = 3.5 × £24 = £84"
  },
  {
    topic: "Percentage Increase",
    text: "Increase £45 by 12%.",
    type: "typed",
    answer: "£50.40",
    accepts: ["50.40","£50.40","50.4","£50.4"],
    solution: "£45 × 1.12 = £50.40"
  },
  {
    topic: "Percentage Decrease",
    text: "Decrease 68 by 23%.",
    type: "typed",
    answer: "52.36",
    accepts: ["52.36"],
    solution: "68 × 0.77 = 52.36"
  },
  {
    topic: "Percentage of an Amount",
    text: "A clock costs £22 plus 18% tax. What is the total cost?",
    type: "mcq",
    options: ["£24.96", "£25.96", "£26.36", "£27.00"],
    answer: "£25.96",
    solution: "£22 × 1.18 = £25.96"
  },
  {
    topic: "Reverse Percentage",
    text: "A jumper costs £31.35 in a '5% off' sale. What was the original price?",
    type: "mcq",
    options: ["£32.00", "£32.50", "£33.00", "£33.50"],
    answer: "£33.00",
    solution: "£31.35 ÷ 0.95 = £33.00"
  },
  {
    topic: "Reverse Percentage",
    text: "If 45% is 18 cm, what is 100%?",
    type: "typed",
    answer: "40 cm",
    accepts: ["40","40cm","40 cm"],
    solution: "1% = 18 ÷ 45 = 0.4 cm, so 100% = 40 cm"
  },
  {
    topic: "Percentage Change",
    text: "A shirt is in a 15% sale and its price is reduced by £7.50. What was the original price?",
    type: "mcq",
    options: ["£45", "£48", "£50", "£52"],
    answer: "£50",
    solution: "15% = £7.50, so 1% = £0.50, so 100% = £50"
  },
  {
    topic: "Reverse Percentage",
    text: "Zara earns £12.96 per hour after a 10% pay cut. What was her original hourly wage?",
    type: "typed",
    answer: "£14.40",
    accepts: ["14.40","£14.40","14.4","£14.4"],
    solution: "£12.96 ÷ 0.90 = £14.40"
  },
  {
    topic: "Percentage Change",
    text: "A 10% increase followed by another 10% increase is equivalent to what overall percentage increase?",
    type: "mcq",
    options: ["20%", "21%", "22%", "19%"],
    answer: "21%",
    solution: "1.10 × 1.10 = 1.21, which is a 21% increase overall"
  },
  {
    topic: "Reverse Percentage",
    text: "In a sale a watch is reduced to $51.80. This is a 7.5% reduction. What was the original price?",
    type: "mcq",
    options: ["$54.00", "$55.00", "$56.00", "$57.00"],
    answer: "$56.00",
    solution: "$51.80 ÷ 0.925 = $56.00"
  }
];

// ─────────────────────────────────────────────────────────────────────────────
// ZONE DEFINITIONS  (as % of goal interior: x%, y%, w%, h% within net area)
// Goal SVG viewBox 420×210; net starts at x=18,y=8, width=384, height=187
// We define 6 zones: TL, TC, TR, BL, BC, BR
// ─────────────────────────────────────────────────────────────────────────────
const ZONES = [
  { id:'tl', label:'↖', row:'top',    col:'left',   ballL:'18%', ballB:'78%' },
  { id:'tc', label:'⬆', row:'top',    col:'centre', ballL:'50%', ballB:'82%' },
  { id:'tr', label:'↗', row:'top',    col:'right',  ballL:'82%', ballB:'78%' },
  { id:'bl', label:'↙', row:'bottom', col:'left',   ballL:'18%', ballB:'42%' },
  { id:'bc', label:'⬇', row:'bottom', col:'centre', ballL:'50%', ballB:'38%' },
  { id:'br', label:'↘', row:'bottom', col:'right',  ballL:'82%', ballB:'42%' },
];

// Miss destinations (ball goes wide/over)
const MISSES = [
  { ballL:'-10%', ballB:'30%' },
  { ballL:'108%', ballB:'25%' },
  { ballL:'50%',  ballB:'-18%' },
  { ballL:'-8%',  ballB:'-10%' },
  { ballL:'105%', ballB:'-12%' },
];

// ─────────────────────────────────────────────────────────────────────────────
// STATE
// ─────────────────────────────────────────────────────────────────────────────
let current  = 0;
let answered = false;  // true after answer submitted, waiting for shot or miss
let shooting = false;  // true while ball animation playing
let goals    = 0;
let results  = [];

// ─────────────────────────────────────────────────────────────────────────────
// INIT
// ─────────────────────────────────────────────────────────────────────────────
function init() {
  buildDots();
  buildZones();
  renderQuestion(0);
}

function buildDots() {
  const row = document.getElementById('ballsRow');
  row.innerHTML = '';
  QUESTIONS.forEach((_, i) => {
    const d = document.createElement('div');
    d.className = 'ball-dot' + (i === 0 ? ' current' : '');
    d.id = 'dot' + i;
    row.appendChild(d);
  });
}

// ─────────────────────────────────────────────────────────────────────────────
// BUILD ZONE OVERLAY
// The overlay is sized to match the rendered SVG exactly.
// Zones are positioned as % of the goal-net interior.
// ─────────────────────────────────────────────────────────────────────────────
function buildZones() {
  const overlay = document.getElementById('zonesOverlay');
  overlay.innerHTML = '';

  ZONES.forEach(z => {
    const div = document.createElement('div');
    div.className = 'goal-zone';
    div.id = 'zone-' + z.id;
    div.innerHTML = `<span class="zone-arrow">${z.label}</span>`;
    div.onclick = () => playerShoot(z);

    // Position: net interior as % of SVG viewBox (420×210)
    // Net: x=18,y=8, w=384,h=187
    // Top row: y=8 → 40% of net height; Bottom row: y=40% → 100%
    const netX = 18, netY = 8, netW = 384, netH = 187;
    const colMap = { left: 0, centre: 1, right: 2 };
    const rowMap = { top: 0, bottom: 1 };
    const col = colMap[z.col], row2 = rowMap[z.row];
    const zoneW = netW / 3;
    const zoneH = netH / 2;
    const zx = netX + col * zoneW;
    const zy = netY + row2 * zoneH;

    // Convert to % of SVG viewBox
    div.style.left   = (zx / 420 * 100) + '%';
    div.style.top    = (zy / 210 * 100) + '%';
    div.style.width  = (zoneW / 420 * 100) + '%';
    div.style.height = (zoneH / 210 * 100) + '%';

    overlay.appendChild(div);
  });

  // Size overlay to match SVG rendered size — use ResizeObserver
  const svg = document.getElementById('goalSvg');
  const wrap = document.getElementById('goalWrap');

  function syncOverlay() {
    const r = svg.getBoundingClientRect();
    const wr = wrap.getBoundingClientRect();
    overlay.style.width  = r.width  + 'px';
    overlay.style.height = r.height + 'px';
    overlay.style.top    = (r.top - wr.top) + 'px';
    overlay.style.left   = (r.left - wr.left) + 'px';
    overlay.style.transform = 'none';
  }

  syncOverlay();
  window.addEventListener('resize', syncOverlay);
  // Also sync after fonts load
  document.fonts.ready.then(syncOverlay);
}

// ─────────────────────────────────────────────────────────────────────────────
// RENDER QUESTION
// ─────────────────────────────────────────────────────────────────────────────
function renderQuestion(idx) {
  answered = false;
  shooting = false;
  const q = QUESTIONS[idx];

  document.getElementById('qNum').textContent   = `Q${idx+1} / ${QUESTIONS.length}`;
  document.getElementById('qTopic').textContent = q.topic;
  document.getElementById('qText').textContent  = q.text;
  document.getElementById('qFeedback').className = 'q-feedback';
  document.getElementById('qFeedback').textContent = '';
  document.getElementById('navRow').style.display  = 'none';

  // Hide zones & prompt
  document.getElementById('zonesOverlay').classList.remove('visible');
  document.getElementById('shootPrompt').classList.remove('visible');

  resetBall();

  const area = document.getElementById('qAnswerArea');
  area.innerHTML = '';

  if (q.type === 'mcq') {
    const grid = document.createElement('div');
    grid.className = 'options-grid';
    q.options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'opt-btn';
      btn.textContent = opt;
      btn.onclick = () => submitAnswer(opt === q.answer, opt, q);
      grid.appendChild(btn);
    });
    area.appendChild(grid);
  } else {
    const row = document.createElement('div');
    row.className = 'typed-row';
    const inp = document.createElement('input');
    inp.className = 'typed-input'; inp.id = 'typedInput';
    inp.placeholder = 'Type your answer…';
    inp.onkeydown = e => { if (e.key === 'Enter') checkTyped(q); };
    const btn = document.createElement('button');
    btn.className = 'shoot-btn'; btn.textContent = '⚽ SHOOT!';
    btn.onclick = () => checkTyped(q);
    row.appendChild(inp); row.appendChild(btn);
    area.appendChild(row);
    setTimeout(() => inp.focus(), 80);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// ANSWER HANDLING
// ─────────────────────────────────────────────────────────────────────────────
function checkTyped(q) {
  if (answered) return;
  const inp = document.getElementById('typedInput');
  const raw = inp.value.trim();
  if (!raw) return;
  const norm = s => s.replace(/[£$\s,]/g,'').toLowerCase().replace(/\.?0+$/,'');
  const correct = q.accepts.some(a => norm(raw) === norm(a));
  inp.disabled = true;
  inp.classList.add(correct ? 'correct' : 'wrong');
  document.querySelector('.shoot-btn').disabled = true;
  submitAnswer(correct, raw, q);
}

function submitAnswer(correct, studentAns, q) {
  if (answered) return;
  answered = true;

  // Colour MCQ buttons if applicable
  document.querySelectorAll('.opt-btn').forEach(btn => {
    btn.disabled = true;
    if (btn.textContent === q.answer) btn.classList.add('correct');
    else if (btn.textContent === studentAns && !correct) btn.classList.add('wrong');
  });

  if (correct) {
    // Show zones — let student pick their spot
    document.getElementById('zonesOverlay').classList.add('visible');
    document.getElementById('shootPrompt').classList.add('visible');
    // Store q & studentAns for after shot
    window._pendingShot = { q, studentAns };
  } else {
    // Auto miss
    autoMiss(q, studentAns);
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// PLAYER CHOOSES A ZONE
// ─────────────────────────────────────────────────────────────────────────────
function playerShoot(zone) {
  if (shooting) return;
  shooting = true;

  // Hide zones & prompt immediately
  document.getElementById('zonesOverlay').classList.remove('visible');
  document.getElementById('shootPrompt').classList.remove('visible');

  const { q, studentAns } = window._pendingShot;

  // Animate ball to chosen zone
  animateBall(zone.ballL, zone.ballB, true, () => {
    showResult(true, q, studentAns);
  });
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTO MISS (wrong answer)
// ─────────────────────────────────────────────────────────────────────────────
function autoMiss(q, studentAns) {
  shooting = true;
  const m = MISSES[Math.floor(Math.random() * MISSES.length)];
  animateBall(m.ballL, m.ballB, false, () => {
    showResult(false, q, studentAns);
  });
}

// ─────────────────────────────────────────────────────────────────────────────
// BALL ANIMATION
// ─────────────────────────────────────────────────────────────────────────────
function resetBall() {
  const ball = document.getElementById('ballSvg');
  // Force no transition first
  ball.style.transition = 'none';
  ball.style.left      = '50%';
  ball.style.bottom    = '-8px';
  ball.style.transform = 'translateX(-50%) scale(1) rotate(0deg)';
  ball.style.opacity   = '1';
  // Clear result flash
  const flash = document.getElementById('resultFlash');
  flash.className = 'result-flash';
  flash.textContent = '';
}

function animateBall(destL, destB, scored, callback) {
  const ball = document.getElementById('ballSvg');
  // Trigger reflow so transition fires properly
  ball.getBoundingClientRect();
  ball.style.transition = 'left 0.5s cubic-bezier(.15,.8,.3,1), bottom 0.5s cubic-bezier(.15,.8,.3,1), transform 0.5s ease, opacity 0.5s ease';
  ball.style.left      = destL;
  ball.style.bottom    = destB;
  ball.style.transform = `translateX(-50%) scale(${scored ? 0.52 : 0.65}) rotate(${scored ? 540 : 200}deg)`;
  ball.style.opacity   = scored ? '0.85' : '0.35';
  setTimeout(callback, 520);
}

// ─────────────────────────────────────────────────────────────────────────────
// SHOW RESULT
// ─────────────────────────────────────────────────────────────────────────────
function showResult(scored, q, studentAns) {
  shooting = false;

  const flash = document.getElementById('resultFlash');
  const fb    = document.getElementById('qFeedback');

  if (scored) {
    goals++;
    flash.textContent = '⚽ GOAL!';
    flash.className   = 'result-flash show goal';
    fb.className      = 'q-feedback correct';
    fb.textContent    = '✅ Correct! ' + q.solution;
  } else {
    flash.textContent = '❌ WIDE!';
    flash.className   = 'result-flash show miss';
    fb.className      = 'q-feedback wrong';
    fb.textContent    = '❌ Incorrect. ' + q.solution;
  }

  results.push({
    topic: q.topic, text: q.text,
    studentAns, correctAns: q.answer,
    scored, solution: q.solution
  });

  document.getElementById('scoreDisplay').textContent = goals + (goals === 1 ? ' GOAL' : ' GOALS');

  // Update dot
  const dot = document.getElementById('dot' + current);
  if (dot) {
    dot.classList.remove('current');
    dot.classList.add(scored ? 'scored' : 'missed');
    dot.textContent = scored ? '⚽' : '✕';
  }
  const nextDot = document.getElementById('dot' + (current + 1));
  if (nextDot) nextDot.classList.add('current');

  document.getElementById('navRow').style.display = 'flex';
}

// ─────────────────────────────────────────────────────────────────────────────
// NAVIGATION
// ─────────────────────────────────────────────────────────────────────────────
function nextQuestion() {
  current++;
  if (current >= QUESTIONS.length) showFinal();
  else renderQuestion(current);
}

// ─────────────────────────────────────────────────────────────────────────────
// FINAL SCREEN
// ─────────────────────────────────────────────────────────────────────────────
function showFinal() {
  document.getElementById('gameArea').style.display = 'none';
  document.getElementById('finalScreen').style.display = 'block';
  document.getElementById('finalScore').innerHTML = `${goals} <span>/ ${QUESTIONS.length}</span>`;

  const pct = (goals / QUESTIONS.length) * 100;
  let stars, msg;
  if      (pct === 100) { stars = '⭐⭐⭐⭐⭐'; msg = 'PERFECT SCORE! World-class striker! 🏆'; }
  else if (pct >= 80)   { stars = '⭐⭐⭐⭐';   msg = 'Excellent! Hat-trick hero! 🎩'; }
  else if (pct >= 60)   { stars = '⭐⭐⭐';     msg = 'Solid performance — keep practising! ⚽'; }
  else if (pct >= 40)   { stars = '⭐⭐';       msg = 'Getting there — review your working! 💪'; }
  else                  { stars = '⭐';         msg = 'Tough match — back to training! 📝'; }

  document.getElementById('finalStars').textContent = stars;
  document.getElementById('finalMsg').textContent   = msg;

  const tbody = document.getElementById('breakdownBody');
  tbody.innerHTML = '';
  results.forEach((r, i) => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td class="icon-cell">${r.scored ? '⚽' : '❌'}</td>
      <td><strong>Q${i+1}</strong> — ${r.topic}<br><span style="color:var(--grey);font-size:0.76rem;">${r.text}</span></td>
      <td style="color:${r.scored ? 'var(--green)' : 'var(--red)'}">${r.studentAns}</td>
      <td style="color:var(--ltgrey)">${r.correctAns}</td>`;
    tbody.appendChild(tr);
  });

  document.getElementById('finalScreen').scrollIntoView({ behavior: 'smooth' });
}

// ─────────────────────────────────────────────────────────────────────────────
// SUBMISSION
// ─────────────────────────────────────────────────────────────────────────────
function generateSummary() {
  const name = document.getElementById('playerName').value.trim() || '(Name not entered)';
  const now  = new Date().toLocaleString('en-GB', { dateStyle:'short', timeStyle:'short' });
  const pct  = Math.round((goals / QUESTIONS.length) * 100);

  let L = [];
  L.push('╔═══════════════════════════════════════════════════════╗');
  L.push('║   MR. GODDARD\'S PENALTY SHOOTOUT — SUBMISSION        ║');
  L.push('║   Topic: Percentages                                  ║');
  L.push('╚═══════════════════════════════════════════════════════╝');
  L.push('');
  L.push(`Player    : ${name}`);
  L.push(`Submitted : ${now}`);
  L.push(`Score     : ${goals} / ${QUESTIONS.length} goals  (${pct}%)`);
  L.push('');
  L.push('─────────────────────────────────────────────────────────');
  L.push('  QUESTION BREAKDOWN');
  L.push('─────────────────────────────────────────────────────────');
  results.forEach((r, i) => {
    L.push(`  ${r.scored ? '⚽ GOAL' : '❌ MISS'}  Q${i+1} [${r.topic}]`);
    L.push(`  Question : ${r.text}`);
    L.push(`  Your ans : ${r.studentAns}`);
    L.push(`  Correct  : ${r.correctAns}`);
    L.push(`  Working  : ${r.solution}`);
    L.push('');
  });
  L.push('─────────────────────────────────────────────────────────');
  L.push(`  FINAL SCORE: ${goals} / ${QUESTIONS.length}  (${pct}%)`);
  L.push('═════════════════════════════════════════════════════════');

  document.getElementById('summaryText').value = L.join('\n');
  document.getElementById('summaryWrap').style.display = 'block';
  setTimeout(() => document.getElementById('summaryText').scrollIntoView({ behavior:'smooth', block:'nearest' }), 100);
}

function copySummary() {
  const ta = document.getElementById('summaryText');
  ta.select(); ta.setSelectionRange(0, 99999);
  try { navigator.clipboard.writeText(ta.value).catch(() => document.execCommand('copy')); }
  catch(e) { document.execCommand('copy'); }
  const c = document.getElementById('copyConfirm');
  c.style.display = 'inline';
  setTimeout(() => { c.style.display = 'none'; }, 3000);
}

// ─────────────────────────────────────────────────────────────────────────────
init();
</script>
</body>
</html>
